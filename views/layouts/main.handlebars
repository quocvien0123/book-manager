<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Sách</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 30px auto; padding: 0 15px; }
    table { border-collapse: collapse; width: 100%; margin-top: 20px; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background: #f0f0f0; }
    input { padding: 6px; margin: 4px 4px 4px 0; }
    .error { color: #b00020; font-weight: bold; }
    footer { margin-top: 40px; padding-top: 10px; border-top: 2px solid #333; text-align: center; }
  </style>
</head>
<body>
  {{{body}}}
  <footer>
    Họ tên: <b>{{hoTen}}</b> | MSSV: <b>{{mssv}}</b> | VAT áp dụng: <b>{{vat}}%</b>
  </footer>
</body>
</html>